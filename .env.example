# Chave da API do MaxPlayer (painel > API). NUNCA coloque isso no HTML.
MAXPLAYER_TOKEN=cole_sua_chave_aqui

# ID do domínio cadastrado no painel MaxPlayer (a URL do servidor fica salva lá)
MAXPLAYER_DOMAIN_ID=1731529261039864009

# Opcional: endereço do servidor Xtream para conferir se o login existe e está ativo
# antes de criar no MaxPlayer. Vazio = não confere (cria direto com o domínio acima).
# Ex.: http://seuservidor.com:8080
XTREAM_URL=

# Opcional: limite de telas por cliente (vazio = teto padrão da sua conta)
MAX_DEVICES=
