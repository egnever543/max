# Chave da API do MaxPlayer (painel > API). NUNCA coloque isso no HTML.
MAXPLAYER_TOKEN=cole_sua_chave_aqui

# ID do domínio cadastrado no painel MaxPlayer. A URL do servidor é lida desse domínio
# pela API e usada para conferir se o login existe e está ativo.
MAXPLAYER_DOMAIN_ID=1731529261039864009

# Opcional: limite de telas por cliente (vazio = teto padrão da sua conta)
MAX_DEVICES=
