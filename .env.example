# Chave da API do MaxPlayer (painel > API). NUNCA coloque isso no HTML.
MAXPLAYER_TOKEN=cole_sua_chave_aqui

# ID do domínio cadastrado no painel MaxPlayer que aponta pro seu servidor
MAXPLAYER_DOMAIN_ID=1731529261039864009

# Endereço do seu servidor Xtream, usado para conferir se o login existe e está ativo
# Ex.: http://seuservidor.com:8080  (sem barra no final)
XTREAM_URL=http://seuservidor.com:8080

# Opcional: limite de telas por cliente (vazio = teto padrão da sua conta)
MAX_DEVICES=
